// Santa Cruz Mountain Photography — own Neon Postgres project, entirely
// separate from santa-cruz-tree-site's database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Single admin identity — no user table. Matches the tree-site pattern:
// one shared password, stored as a bcrypt hash that can be rotated without
// a redeploy (falls back to ADMIN_PASSWORD_HASH env var if no row exists).
model AdminConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Photo {
  id        String    @id @default(cuid())
  url       String
  pathname  String    // Vercel Blob pathname, needed to delete the blob later
  alt       String    @default("")
  order     Int       @default(0)
  // Intrinsic pixel size, captured at upload time. Lets the public gallery
  // compute its justified-row layout from known numbers instead of
  // downloading every full-size photo up front just to read its
  // dimensions — that preload-before-render was the gallery's main slow-load
  // cause. 0 means "not known yet" (older rows from before this existed);
  // the gallery falls back to measuring those individually.
  width     Int       @default(0)
  height    Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([order])
}

model Post {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String    // listing-page summary + meta description fallback
  content         String    // Markdown, rendered to HTML at request time
  coverImageUrl   String    @default("")
  coverImagePathname String @default("") // Vercel Blob pathname, "" if no cover uploaded
  coverImageAlt   String    @default("")
  metaTitle       String    @default("") // overrides <title>; falls back to title
  metaDescription String    @default("") // overrides meta description; falls back to excerpt
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, publishedAt])
}
